@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}



<form id="account" method="post" class="login-container">
    <h1 class="">LOGIN</h1>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="">
        <div class="input-container">
            <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
            <input asp-for="Input.Email" class="" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
        </div>
        
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="">
        <div class="input-container">
            <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
            <input asp-for="Input.Password" class="" autocomplete="current-password" aria-required="true" placeholder="password"/>
        </div>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    @* <div class="login-checkbox-container"> *@
    @*     <input class="login-checkbox" asp-for="Input.RememberMe"/> *@
    @*     <label asp-for="Input.RememberMe" class="login-checkbox-label"> *@
    @*         @Html.DisplayNameFor(m => m.Input.RememberMe) *@
    @*     </label> *@
    @* </div> *@
    <div>
        <button id="login-submit" type="submit" class="login-button">Log in</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
