@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}



        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="login-container">
            <h1>REGISTER</h1>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="">
                <div class="input-container">
                    <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
                    <input asp-for="Input.Email" class="" autocomplete="username" aria-required="true" placeholder="name@example.com"/>
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="">
                <div class="input-container">
                    <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Input.Password" class="" autocomplete="new-password" aria-required="true" placeholder="password"/>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="">
                <div class="input-container">
                    <span class="input-icon"><i class="fa-solid fa-lock"></i></span>
                    <input asp-for="Input.ConfirmPassword" class="" autocomplete="new-password" aria-required="true" placeholder="confirm password"/>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="login-button">Register</button>
        </form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
