@model Services.ViewModels.BetViewModel
@{
    ViewData["Title"] = "Setup";
}

<div class="game-board"></div>

<div class="setup-container">
    <h2 class="heading">Setup</h2>
    <p>Wager: @Model.BetAmount</p>
    <form method="post">
        <input type="hidden" asp-for="BetAmount" value="@Model.BetAmount"/>
        <button type="submit"
                class="btn btn-primary"
                name="betToAdd"
                value="10">
            +10
        </button>
        <button type="submit"
                class="btn btn-primary"
                name="betToAdd"
                value="50">
            +50
        </button>
        <button type="submit"
                class="btn btn-primary"
                name="betToAdd"
                value="100">
            +100
        </button>
    </form>
</div>
