@model Services.ViewModels.BetViewModel
@{
    ViewData["Title"] = "Setup";
}


<div class="setup-container">
    <h2 class="setup-header">BLACKJACK</h2>
    <p class="balance-text">Balance: $@Model.Balance</p>
    <p class="bet-text">PLACE YOUR BET</p>
    <div class="setup-secondary-container">
        <div class="start-game-btn wager">
            <span>Wager</span>
            <span class="wager-amount">$@Model.BetAmount</span>
        </div>
        <form method="post" class="setup-btn-container">
            <input type="hidden" asp-for="BetAmount" value="@Model.BetAmount"/>
            <input type="hidden" asp-for="Balance" value="@Model.Balance"/>
            <div>
                <button type="submit" 
                        name="betToAdd"
                        value="10"
                        style="border: none; background: none;">
                    <img src="img/chip10.png" alt="submit"/>    
                </button>
                <button type="submit" 
                        name="betToAdd"
                        value="50"
                        style="border: none; background: none;">
                    <img src="img/chip50.png" alt="submit"/>    
                </button>
                <button type="submit" 
                        name="betToAdd"
                        value="100"
                        style="border: none; background: none;">
                    <img src="img/chip100.png" alt="submit"/>    
                </button>
            </div>
        
            <button type="submit"
                    asp-action="StartGame"
                    class="start-game-btn">
                START GAME
            </button>
        
        </form>
    </div>
    
</div>

@if (TempData["Result"] != null)
{
    <p class="text-danger text-center invalid-text">@TempData["Result"]</p>
}
