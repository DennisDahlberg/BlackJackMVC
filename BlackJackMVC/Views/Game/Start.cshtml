@model Services.ViewModels.GameViewModel

@{
    ViewData["Title"] = "Game";
}

@if (TempData["Result"] != null)
{
    <div class="result-overlay">
        <form class="result-container">
            <span>@TempData["Result"]</span>
            <button asp-action="Index" class="overlay-btn">
                PLAY AGAIN
            </button>
            <button asp-controller="Home" asp-action="Index" class="overlay-btn">
                QUIT
            </button>
        </form>
    </div>
}

<div class="pause-overlay hide-overlay">
    <div class="pause-container">
        <span class="overlay-btn">CONTINUE</span>
        <span class="overlay-btn">QUIT</span>
    </div>
</div>

<span class="menu-btn">
    <i class="fa-solid fa-gear"></i>
</span>

<div class="game-info">
    <span>BALANCE: @Model.Balance</span>
    <span>BET: @Model.BetAmount</span>
</div>

<div class="game-board">
    <div class="hand">
        <div class="score-container">
            <span class="score">@Model.ComputerPoints</span>
            <span>DEALER</span>
        </div>
        <div class="card-container">
            @foreach (var card in @Model.HouseHand)
            {
                <img src="~/img/cards/@card.ImageUrl" alt="card"/>
            }
        </div>
    </div>

    <div class="hand">
        <div class="score-container">
            <span class="score">@Model.PlayerPoints</span>
            <span>PLAYER</span>
        </div>
        <div class="card-container">
            @foreach (var card in @Model.PlayerHand)
            {
                <img src="~/img/cards/@card.ImageUrl" alt="card"/>
            }    
        </div>
    </div>
    <div class="game-btn-container">
        <form method="post">
            <input type="hidden" asp-for="Deck" value="@Model.Deck"/>
            <input type="hidden" asp-for="PlayerHand" value="@Model.PlayerHand"/>
            <input type="hidden" asp-for="BetAmount" value="@Model.BetAmount"/>
            <input type="hidden" asp-for="ComputerPoints" value="@Model.ComputerPoints"/>
            <input type="hidden" asp-for="HouseHand" value="@Model.HouseHand"/>
            <input type="hidden" asp-for="PlayerPoints" value="@Model.PlayerPoints"/>
            
            <button asp-action="Draw">
                <i class="fa-solid fa-plus"></i>
            </button>
            <button asp-action="Stand">
                <i class="fa-solid fa-hand"></i>
            </button>
        </form>
    </div>
</div>



<script>
    const pauseBtn = document.querySelector('.menu-btn');
    const pauseOverlay = document.querySelector('.pause-overlay');
    
    pauseBtn.addEventListener('click', () => {
        pauseOverlay.classList.toggle('hide-overlay');
    })
</script>








